# 複製這個檔為 .env 並填入實際數值。.env 已被 .gitignore 排除，不要提交。
#
#     copy .env.example .env
#     python settings.py        # 確認有讀到（金鑰會遮蔽顯示）

# --- LINE ---------------------------------------------------------------
# LINE Developers > Messaging API > Channel access token
LINE_CHANNEL_ACCESS_TOKEN=
# LINE Developers > Basic settings > Channel secret（LineBot.py 驗簽用）
LINE_CHANNEL_SECRET=

# 推播目標。索引從 1 起算，對應程式裡的 channel 參數（按鍵 1~9）。
# 使用者 ID 以 U 開頭、群組 ID 以 C 開頭；把機器人加進群組後看主控台輸出。
LINE_CHANNEL_1=
LINE_CHANNEL_2=
LINE_CHANNEL_3=

# --- 圖片上傳 -----------------------------------------------------------
# Imgur API 已停用，改用 imgbb。到 https://api.imgbb.com/ 免費申請。
IMGBB_API_KEY=
# 圖片保存秒數，留空 = 永不過期。imgbb 接受 60 ~ 15552000（180 天）。
IMGBB_EXPIRATION=
# 上傳逾時秒數
UPLOAD_TIMEOUT=30

# --- Email 通知（選用，預設沒啟用） -------------------------------------
GMAIL_APP_PASSWORD=
